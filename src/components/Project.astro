---
const { name, href, desc } = Astro.props;
---

<style>
  section {
    border: var(--accent) 1.5pt solid;
    border-radius: 10px;
    display: flex;
    flex-flow: column wrap;
    padding: 1em;
    margin: 1em 0;
    h2,
    p {
      margin: 0;
    }
  }
</style>

<section>
  <a {href}>
    <h2>{name}</h2>
  </a>
  <p>{desc}</p>
</section>
