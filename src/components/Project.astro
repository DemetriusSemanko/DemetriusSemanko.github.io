---
const { name, href, desc } = Astro.props;
---

<style>
  .project {
    border: var(--accent) 1.5pt solid;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    padding: 1em;
    margin: 1em 0;
    h2,
    p {
      margin: 0;
    }
  }
</style>

<section class="project">
  <a {href}>
    <h2>{name}</h2>
  </a>
  <p>{desc}</p>
</section>
