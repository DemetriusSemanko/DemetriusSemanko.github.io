---
const { href, label } = Astro.props;
/*
Thank you, bwc9876, for helping me figure the `isActive` stuff out! :-)
*/
const isActive =
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
---

<style>
  @media (prefers-color-scheme: light) {
    .titular-navbar-tab {
      color: var(--text);
    }
  }

  @media (prefers-color-scheme: dark) {
    .titular-navbar-tab {
      color: white;
    }
  }

  a {
    background-color: var(--primary);
    border: var(--shadow) 1.5pt solid;
    border-radius: 5px;
    color: white;
    font-weight: bold;
    margin: 4px;
    padding: 5px 10px;
    text-decoration: none;
    &.titular-navbar-tab {
      background-color: var(--secondary);
    }
  }

  @media screen and (min-width: 965px) {
    /* Large screen styles */
    a {
      padding-left: 20px;
      padding-right: 15px;
      width: max-content;
    }
  }
</style>
<a {href} class={isActive ? "titular-navbar-tab" : undefined}>{label}</a>
